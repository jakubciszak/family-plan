{
  "name": "family-plan-frontend",
  "version": "1.0.0",
  "description": "Family Plan React Frontend Application",
  "private": true,
  "scripts": {
    "start": "webpack serve --mode development --open",
    "build": "webpack --mode production",
    "dev": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:webkit": "playwright test --project=webkit",
    "test:report": "playwright show-report",
    "test:artifacts": "node ./scripts/prepare-playwright-artifacts.js",
    "test:e2e": "playwright test --config=playwright.real.config.js",
    "test:e2e:headed": "playwright test --config=playwright.real.config.js --headed",
    "test:e2e:debug": "playwright test --config=playwright.real.config.js --debug",
    "theme": "node --no-warnings --import \"data:text/javascript,import { register } from 'node:module'; import { pathToFileURL } from 'node:url'; register('./scripts/extensionless-loader.mjs', pathToFileURL('./'));\" scripts/generate-theme.mjs",
    "icons": "node scripts/generate-icons.mjs"
  },
  "dependencies": {
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.3",
    "@material/material-color-utilities": "^0.4.0",
    "i18next": "^25.7.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-http-backend": "^3.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^16.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.17.0",
    "@babel/preset-env": "^7.16.0",
    "@babel/preset-react": "^7.18.0",
    "@material-symbols/svg-400": "^0.47.2",
    "@playwright/test": "^1.57.0",
    "babel-loader": "^9.1.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^6.7.0",
    "html-webpack-plugin": "^5.5.0",
    "style-loader": "^3.3.0",
    "webpack": "^5.74.0",
    "webpack-cli": "^5.1.0",
    "webpack-dev-server": "^4.15.0"
  }
}
