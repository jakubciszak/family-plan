{% extends 'base.html.twig' %}

{% block title %}Create Task from Template - Family Plan{% endblock %}

{% block body %}
<div class="create-task-execution-container">
    <h1>✅ Create Task Execution from Template</h1>
    
    <div class="template-task-info">
        <h3>{{ template.name().value() }}</h3>
        <p>{{ template.description() }}</p>
        <p><strong>Points:</strong> {{ template.points().value() }}</p>
        <p><strong>Schedule:</strong> 
            {% if template.scheduleConfig() %}
                {% if template.scheduleConfig().type == 'daily' %}
                    Every day
                {% elseif template.scheduleConfig().type == 'weekly' %}
                    Every {{ ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'][template.scheduleConfig().dayOfWeek - 1] }}
                {% elseif template.scheduleConfig().type == 'monthly' %}
                    Day {{ template.scheduleConfig().dayOfMonth }} of every month
                {% elseif template.scheduleConfig().type == 'times_per_week' %}
                    {{ template.scheduleConfig().timesPerWeek }} times per week
                {% endif %}
            {% endif %}
        </p>
    </div>
    
    <form method="post" class="task-form">
        <div class="form-group">
            <label for="scheduled_for">Scheduled For *</label>
            <input type="datetime-local" id="scheduled_for" name="scheduled_for" class="form-control" required value="{{ 'now'|date('Y-m-d\\TH:i') }}">
            <small class="form-text">Select when this task should be executed</small>
        </div>
        
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Create Task Execution</button>
            <a href="{{ path('app_task_template_view', {id: template.id().value()}) }}" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
{% endblock %}
