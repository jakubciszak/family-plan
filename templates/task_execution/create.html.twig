{% extends 'base.html.twig' %}

{% block title %}Create Task Execution - Family Plan{% endblock %}

{% block body %}
<div class="create-task-execution-container">
    <h1>✅ Create New Task Execution</h1>
    
    <form method="post" class="task-form">
        <div class="form-group">
            <label for="execution_type">Task Type *</label>
            <select id="execution_type" class="form-control" required>
                <option value="one_time">One-time Task</option>
                <option value="from_template">From Task Template</option>
            </select>
        </div>
        
        <div id="template_task_select" style="display: none;">
            <div class="form-group">
                <label for="template_task_id">Select Task Template</label>
                <select id="template_task_id" name="template_task_id" class="form-control">
                    <option value="">-- Select a task template --</option>
                    {% for template in templates %}
                        <option value="{{ template.id().value() }}">
                            {{ template.name().value() }} ({{ template.points().value() }} pts)
                        </option>
                    {% endfor %}
                </select>
            </div>
        </div>
        
        <div id="one_time_fields">
            <div class="form-group">
                <label for="name">Task Name *</label>
                <input type="text" id="name" name="name" class="form-control" maxlength="255">
            </div>
            
            <div class="form-group">
                <label for="description">Description *</label>
                <textarea id="description" name="description" class="form-control" rows="4"></textarea>
            </div>
            
            <div class="form-group">
                <label for="points">Points *</label>
                <input type="number" id="points" name="points" class="form-control" min="0" max="1000" value="10">
            </div>
        </div>
        
        <div class="form-group">
            <label for="scheduled_for">Scheduled For *</label>
            <input type="datetime-local" id="scheduled_for" name="scheduled_for" class="form-control" required value="{{ 'now'|date('Y-m-d\\TH:i') }}">
        </div>
        
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Create Task Execution</button>
            <a href="{{ path('app_task_execution_list') }}" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>

<script>
document.getElementById('execution_type').addEventListener('change', function() {
    const isTemplate = this.value === 'from_template';
    
    document.getElementById('template_task_select').style.display = isTemplate ? 'block' : 'none';
    document.getElementById('one_time_fields').style.display = isTemplate ? 'none' : 'block';
    
    // Toggle required attributes
    document.getElementById('template_task_id').required = isTemplate;
    document.getElementById('name').required = !isTemplate;
    document.getElementById('description').required = !isTemplate;
    document.getElementById('points').required = !isTemplate;
});
</script>
{% endblock %}
