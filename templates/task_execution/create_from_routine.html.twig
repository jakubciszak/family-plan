{% extends 'base.html.twig' %}

{% block title %}Create Task from Routine - Family Plan{% endblock %}

{% block body %}
<div class="create-task-execution-container">
    <h1>✅ Create Task Execution from Routine</h1>
    
    <div class="routine-task-info">
        <h3>{{ routineTask.name().value() }}</h3>
        <p>{{ routineTask.description() }}</p>
        <p><strong>Points:</strong> {{ routineTask.points().value() }}</p>
        <p><strong>Schedule:</strong> 
            {% if routineTask.scheduleConfig().type == 'daily' %}
                Every day
            {% elseif routineTask.scheduleConfig().type == 'weekly' %}
                Every {{ ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'][routineTask.scheduleConfig().dayOfWeek - 1] }}
            {% elseif routineTask.scheduleConfig().type == 'monthly' %}
                Day {{ routineTask.scheduleConfig().dayOfMonth }} of every month
            {% elseif routineTask.scheduleConfig().type == 'times_per_week' %}
                {{ routineTask.scheduleConfig().timesPerWeek }} times per week
            {% endif %}
        </p>
    </div>
    
    <form method="post" class="task-form">
        <div class="form-group">
            <label for="scheduled_for">Scheduled For *</label>
            <input type="datetime-local" id="scheduled_for" name="scheduled_for" class="form-control" required value="{{ 'now'|date('Y-m-d\\TH:i') }}">
            <small class="form-text">Select when this task should be executed</small>
        </div>
        
        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Create Task Execution</button>
            <a href="{{ path('app_routine_task_view', {id: routineTask.id().value()}) }}" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</div>
{% endblock %}
