{% extends 'base.html.twig' %}

{% block title %}Routine Task Details - Family Plan{% endblock %}

{% block body %}
<div class="routine-task-view-container">
    <div class="page-header">
        <h1>🔄 {{ routineTask.name().value() }}</h1>
        <div class="header-actions">
            <a href="{{ path('app_routine_task_list') }}" class="btn btn-secondary">← Back to List</a>
            <a href="{{ path('app_task_execution_create_from_routine', {routineTaskId: routineTask.id().value()}) }}" class="btn btn-primary">Create Execution</a>
        </div>
    </div>
    
    <div class="task-details">
        <div class="detail-section">
            <h3>Details</h3>
            <dl>
                <dt>Description</dt>
                <dd>{{ routineTask.description() }}</dd>
                
                <dt>Points</dt>
                <dd>{{ routineTask.points().value() }} points</dd>
                
                <dt>Frequency</dt>
                <dd>{{ routineTask.frequency().label() }}</dd>
                
                <dt>Schedule</dt>
                <dd>
                    {% if routineTask.scheduleConfig().type == 'daily' %}
                        Every day
                    {% elseif routineTask.scheduleConfig().type == 'weekly' %}
                        Every {{ ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'][routineTask.scheduleConfig().dayOfWeek - 1] }}
                    {% elseif routineTask.scheduleConfig().type == 'monthly' %}
                        Day {{ routineTask.scheduleConfig().dayOfMonth }} of every month
                    {% elseif routineTask.scheduleConfig().type == 'times_per_week' %}
                        {{ routineTask.scheduleConfig().timesPerWeek }} times per week
                    {% elseif routineTask.scheduleConfig().type == 'once' %}
                        One time only
                    {% endif %}
                </dd>
                
                <dt>Status</dt>
                <dd>
                    {% if routineTask.isActive() %}
                        <span class="badge badge-success">Active</span>
                    {% else %}
                        <span class="badge badge-secondary">Inactive</span>
                    {% endif %}
                </dd>
                
                <dt>Created At</dt>
                <dd>{{ routineTask.createdAt()|date('Y-m-d H:i') }}</dd>
                
                {% if routineTask.updatedAt() %}
                <dt>Updated At</dt>
                <dd>{{ routineTask.updatedAt()|date('Y-m-d H:i') }}</dd>
                {% endif %}
            </dl>
        </div>
        
        <div class="action-section">
            <h3>Actions</h3>
            {% if routineTask.isActive() %}
                <form method="post" action="{{ path('app_routine_task_deactivate', {id: routineTask.id().value()}) }}">
                    <button type="submit" class="btn btn-warning btn-block">Deactivate</button>
                </form>
            {% else %}
                <form method="post" action="{{ path('app_routine_task_activate', {id: routineTask.id().value()}) }}">
                    <button type="submit" class="btn btn-success btn-block">Activate</button>
                </form>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
