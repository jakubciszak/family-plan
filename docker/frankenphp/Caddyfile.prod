{
	{$CADDY_GLOBAL_OPTIONS}

	frankenphp {
		worker {
			file /app/public/index.php
			num {$FRANKENPHP_NUM_WORKERS:4}
		}
	}
}

{$SERVER_NAME::80} {
	log {
		format console
	}

	root /app/public
	encode zstd br gzip

	@symfony path /api/* /_components/*
	handle @symfony {
		php_server
	}

	handle {
		@immutable path /js/* /css/* /build/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"

		@revalidate path / /index.html /sw.js /manifest.json
		header @revalidate Cache-Control "no-cache"

		try_files {path} /index.html
		file_server
	}
}
