FROM dunglas/frankenphp:1-php8.4 AS base

ENV APP_ENV=prod \
    COMPOSER_ALLOW_SUPERUSER=1 \
    SERVER_NAME=:80

WORKDIR /app

RUN install-php-extensions \
        intl \
        pdo_pgsql \
        zip \
        opcache \
    && apt-get update \
    && apt-get install -y --no-install-recommends \
        git \
        unzip \
        postgresql-client \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY docker/frankenphp/conf.d/app.prod.ini /usr/local/etc/php/conf.d/app.ini


FROM base AS builder

COPY composer.json composer.lock symfony.lock ./
RUN composer install --no-dev --no-scripts --no-progress --optimize-autoloader

COPY . .

RUN composer dump-autoload --optimize --no-dev --classmap-authoritative \
    && php bin/console cache:clear --env=prod --no-warmup \
    && php bin/console cache:warmup --env=prod


FROM node:20-alpine AS encore_builder

WORKDIR /app

COPY --from=builder /app/vendor ./vendor
COPY package*.json webpack.config.js babel.config.js ./
COPY assets ./assets

RUN npm ci && npm run build


FROM node:20-alpine AS spa_builder

WORKDIR /app

ARG REACT_APP_API_URL=""
ENV REACT_APP_API_URL=$REACT_APP_API_URL

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/public ./public
COPY frontend/src ./src
COPY frontend/webpack.config.js ./

RUN npm run build


FROM base AS production

COPY --from=builder /app /app
COPY --from=encore_builder /app/public/build /app/public/build
COPY --from=spa_builder /app/dist /app/public

COPY docker/frankenphp/Caddyfile.prod /etc/frankenphp/Caddyfile
COPY docker/frankenphp/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

RUN chmod +x /usr/local/bin/docker-entrypoint.sh \
    && setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/frankenphp \
    && chown -R www-data:www-data /app/var /data/caddy /config/caddy

USER www-data

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile"]
