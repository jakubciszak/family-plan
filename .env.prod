# Local template for docker-compose.hostinger.yml.
# GitHub Actions passes these values to Hostinger from the "production" environment.

IMAGE_TAG=latest

APP_SCHEME=https
APP_DOMAIN=family-plan.example.com
APP_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

POSTGRES_DB=family_plan
POSTGRES_USER=family_plan
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_NAME="Super Admin"
SUPER_ADMIN_PASSWORD=CHANGE_ME_USE_A_LONG_UNIQUE_PASSWORD

BACKUP_RETENTION_DAYS=7

MAILER_DSN=null://null
MAILER_FROM_EMAIL=noreply@familyplan.local
MAILER_FROM_NAME="Family Plan"

SMS_API_TOKEN=
