# Production Environment Configuration for Hostinger Deployment
# Copy this file to .env.prod.local and update with your production values

###> symfony/framework-bundle ###
APP_ENV=prod
# IMPORTANT: Generate a new secret key for production
# You can generate one using: php -r "echo bin2hex(random_bytes(16));"
# Or use: openssl rand -hex 16
APP_SECRET=PLEASE_CHANGE_THIS_TO_A_RANDOM_SECRET_KEY_MINIMUM_32_CHARACTERS
###< symfony/framework-bundle ###

###> Database Configuration ###
POSTGRES_VERSION=16
POSTGRES_DB=family_plan
POSTGRES_USER=family_plan_user
# IMPORTANT: Change this to a strong password in production
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
###< Database Configuration ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@database:5432/${POSTGRES_DB}?serverVersion=${POSTGRES_VERSION}&charset=utf8"
###< doctrine/doctrine-bundle ###

###> Super Admin Configuration ###
# Configure the super admin user credentials
SUPER_ADMIN_EMAIL=admin@familyplan.local
SUPER_ADMIN_NAME="Super Admin"
# IMPORTANT: Change this to a strong password in production (min 12 chars, mixed case, numbers, symbols)
SUPER_ADMIN_PASSWORD=PLEASE_CHANGE_TO_STRONG_PASSWORD_MIN_12_CHARS
###< Super Admin Configuration ###

###> Application Ports ###
# Port for the main application (Nginx + PHP)
APP_PORT=8080
# Port for standalone React frontend (optional)
REACT_PORT=3001
###< Application Ports ###

###> Routing ###
# Configure the default URI for CLI commands
DEFAULT_URI=http://localhost:8080
###< Routing ###

###> Optional Nginx Configuration ###
NGINX_HOST=localhost
NGINX_PORT=80
###< Optional Nginx Configuration ###
